<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0"> 
  <title>極簡單據記帳 App</title>
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#4F46E5">
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Tesseract.js (用於 OCR 單據辨識) -->
</head>
<body class="bg-slate-100 min-h-screen pb-12 text-slate-800">
  <!-- 頂部導覽列 -->
  <header class="bg-indigo-600 text-white p-4 shadow-md sticky top-0 z-10">
    <div class="max-w-md mx-auto flex justify-between items-center">
      <h1 class="text-xl font-bold">SmartExpense PWA</h1>
      <span id="pwa-status" class="text-xs bg-indigo-500 px-2 py-1 rounded">離線可用</span>
    </div>
  </header>

  <main class="max-w-md mx-auto p-4 space-y-6">
    <!-- 單據掃描專區 -->
    <section class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
      <h2 class="font-bold text-lg mb-2 text-indigo-900">📷 單據/發票 AI 辨識</h2>
      <p class="text-xs text-slate-500 mb-4">上傳或拍攝收據照片，系統將自動擷取金額與文字。</p>
      
      <label class="block w-full flex flex-col items-center justify-center p-4 border-2 border-dashed border-indigo-300 rounded-xl cursor-pointer bg-indigo-50 hover:bg-indigo-100 transition">
        <svg class="w-8 h-8 text-indigo-500 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h0.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        <span class="text-sm font-medium text-indigo-600">拍攝/選擇單據圖片</span>
        <input type="file" id="ocr-input" accept="image/*" capture="environment" class="hidden">
      </label>

      <!-- OCR 辨識狀態與結果預覽 -->
      <div id="ocr-loading" class="hidden mt-3 text-center text-sm text-indigo-600 font-medium animate-pulse">
        正在解析單據中，請稍候...
      </div>
      <div id="ocr-preview" class="hidden mt-3 p-3 bg-slate-50 rounded-lg text-xs space-y-1">
        <div class="font-bold text-slate-700">辨識到的內容摘要：</div>
        <p id="ocr-text-result" class="text-slate-600 break-words max-h-24 overflow-y-auto"></p>
      </div>
    </section>

    <!-- 手動/辨識帶入 記帳表單 -->
    <section class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
      <h2 class="font-bold text-lg mb-4 text-slate-800">✍️ 記帳資料填寫</h2>
      <form id="expense-form" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">消費描述/店家名稱</label>
          <input type="text" id="desc-input" required placeholder="例如：7-Eleven 買咖啡" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">金額 ($)</label>
          <input type="number" id="amount-input" step="0.01" required placeholder="0.00" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-lg font-bold">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">日期</label>
          <input type="date" id="date-input" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl shadow-md transition">儲存支出紀錄</button>
      </form>
    </section>

    <!-- 歷史支出清單 -->
    <section class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
      <div class="flex justify-between items-center mb-4">
        <h2 class="font-bold text-lg text-slate-800">📋 最近支出紀錄</h2>
        <span id="total-amount" class="text-indigo-600 font-extrabold text-base">總計: $0</span>
      </div>
      <ul id="expense-list" class="divide-y divide-slate-100">
        <!-- 紀錄會動態加載到這裡 -->
      </ul>
    </section>
  </main>

  <script src="app.js"></script>
</body>
</html>
